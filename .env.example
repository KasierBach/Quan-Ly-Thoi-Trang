APP_ENV=development
DISABLE_DOTENV=0
# Generate independently: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/thua2_db
# Use an absolute directory on a persistent volume when running in a container or cloud service.
UPLOAD_ROOT=
TRUSTED_HOSTS=localhost,127.0.0.1
TRUSTED_PROXY_COUNT=0
MAIL_SUPPRESS_SEND=true
# Optional real mail integrations; disabled by default.
# Brevo HTTP API (Render blocks outbound SMTP ports): set BREVO_API_KEY and
# MAIL_SUPPRESS_SEND=false — sender is MAIL_DEFAULT_SENDER, verified in Brevo.
BREVO_API_KEY=
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=465
MAIL_USE_SSL=true
MAIL_USE_TLS=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
PIXABAY_API_KEY=
# Production additionally requires HTTPS PUBLIC_BASE_URL and shared rate-limit storage.
PUBLIC_BASE_URL=
RATELIMIT_STORAGE_URI=memory://
# Leave blank for the normal single-process runtime; scale proof is local-only.
SOCKETIO_MESSAGE_QUEUE=
# User-owned credentials only. Missing credentials keep provider buttons disabled.
OAUTH_ENABLED=false
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
# Address estimates only, not carrier tracking. Public-network lookups stay off.
# Never send private/confidential shipping addresses to public Nominatim.
GEOCODE_ENABLED=false
GEOCODE_NETWORK_ENABLED=false
GEOCODE_ALLOW_PUBLIC_ADDRESS_QUERIES=false
# Genuine operator identity/contact required before enabling network queries.
GEOCODE_USER_AGENT=
GEOCODE_CONTACT=
