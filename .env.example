APP_ENV=development
DISABLE_DOTENV=0
# Generate independently: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/thua2_db
TRUSTED_HOSTS=localhost,127.0.0.1
TRUSTED_PROXY_COUNT=0
MAIL_SUPPRESS_SEND=true
# Optional real mail and image-search integrations; disabled by default.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=465
MAIL_USE_SSL=true
MAIL_USE_TLS=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
PIXABAY_API_KEY=
# Production additionally requires HTTPS PUBLIC_BASE_URL and shared rate-limit storage.
PUBLIC_BASE_URL=
RATELIMIT_STORAGE_URI=memory://
